---
import { venueLine, type Publication } from '../lib/data';
import AuthorList from './AuthorList.astro';
import Bibtex from './Bibtex.astro';

interface Props { pub: Publication; compact?: boolean }
const { pub, compact = false } = Astro.props;
const extAttrs = pub.external ? { target: '_blank', rel: 'noopener' } : {};
const pills = Object.entries(pub.links);
---

<article class:list={['pub', { compact, 'no-thumb': !pub.thumbnail }]}>
  {
    pub.thumbnail && (
      <a class="thumb" href={pub.href} {...extAttrs} tabindex="-1" aria-hidden="true">
        <img src={pub.thumbnail} alt="" loading="lazy" decoding="async" />
      </a>
    )
  }
  <div class="body">
    <h3 class="title">
      <a href={pub.href} class:list={{ ext: pub.external }} {...extAttrs}>{pub.title}</a>
    </h3>
    <p class="meta authors-line"><AuthorList authors={pub.authors} equal={pub.equalContribution} max={compact ? 6 : 8} /></p>
    <p class="meta venue">
      {pub.venueShort && <span class="badge">{pub.venueShort}{/\d{4}/.test(pub.venue) ? '' : ` ${pub.year}`}</span>}
      <span class="muted">{venueLine(pub)}</span>
    </p>
    {
      !compact && (
        <div class="actions">
          {pub.hasPage && <a class="pill solid" href={pub.href}>Project page</a>}
          {pills.map(([label, url]) => (
            <a class="pill" href={url} {...(url.startsWith('/') ? {} : { target: '_blank', rel: 'noopener' })}>{label}</a>
          ))}
          {pub.abstract && (
            <button class="pill" type="button" data-toggle={`abs-${pub.id}`} aria-expanded="false" aria-controls={`abs-${pub.id}`}>
              Abstract
            </button>
          )}
          <button class="pill" type="button" data-toggle={`bibwrap-${pub.id}`} aria-expanded="false" aria-controls={`bibwrap-${pub.id}`}>
            BibTeX
          </button>
        </div>
      )
    }
    {!compact && pub.abstract && <p class="abstract" id={`abs-${pub.id}`} hidden>{pub.abstract}</p>}
    {
      !compact && (
        <div class="panel" id={`bibwrap-${pub.id}`} hidden>
          <Bibtex id={pub.id} bibtex={pub.bibtex} />
        </div>
      )
    }
  </div>
</article>

<style>
  .pub {
    display: grid; grid-template-columns: 180px 1fr; gap: 1.4rem;
    padding: 1.4rem 0; border-top: 1px solid var(--line);
  }
  .pub:first-child { border-top: 0; }
  .pub.no-thumb { grid-template-columns: 1fr; }
  .pub.compact { grid-template-columns: 150px 1fr; gap: 1.1rem; padding: 1.1rem 0; }
  .thumb {
    display: block; align-self: start; border-radius: 8px; overflow: hidden;
    border: 1px solid var(--line); background: #fff; aspect-ratio: 16 / 10;
  }
  .thumb img { width: 100%; height: 100%; object-fit: contain; transition: transform 0.3s ease; }
  .thumb:hover img { transform: scale(1.03); }
  .title { margin: 0 0 0.35rem; font-size: 1.05rem; line-height: 1.35; }
  .title a { color: var(--text); }
  .title a:hover { color: var(--accent); }
  .meta { margin: 0 0 0.2rem; font-size: 0.9rem; color: var(--text-soft); }
  .venue { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .actions { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0.45rem; margin-top: 0.75rem; }
  .actions .pill { font-size: 0.8rem; padding: 0.2em 0.75em; }
  .actions [aria-expanded='true'] { border-color: var(--accent); color: var(--accent); }
  .abstract { font-size: 0.9rem; color: var(--text-soft); margin: 0.8rem 0 0; }
  .panel { margin-top: 0.4rem; }

  @media (max-width: 620px) {
    .pub, .pub.compact { grid-template-columns: 1fr; gap: 0.8rem; }
    .thumb { max-width: 360px; }
  }
</style>
