---
import Base from '../layouts/Base.astro';
import AuthorList from '../components/AuthorList.astro';
import { profile, cv, getPublications, isSet, venueLine, md, type CvEntry } from '../lib/data';

const pubs = await getPublications();
const sections = (
  [
    ['Education', cv.education],
    ['Fellowships & Awards', cv.awards ?? []],
    ['Experience', cv.experience],
    ['Mentoring', cv.mentoring ?? []],
    ['Teaching', cv.teaching],
  ] as [string, CvEntry[]][]
).filter(([, entries]) => entries.length > 0);
---

<Base title="CV" description={`Curriculum vitae of ${profile.name}.`}>
  <header class="cv-head">
    <div>
      <h1>Curriculum Vitae</h1>
      <p class="muted">{profile.name} · {profile.role}, {profile.affiliation}</p>
    </div>
    {
      isSet(profile.links.cv) ? (
        <div class="downloads">
          <a class="pill solid" href={profile.links.cv} download>Resume (1 page)</a>
          <a class="pill" href="/cv/Emilien_Seiler_CV.pdf" download>Full CV</a>
        </div>
      ) : (
        <span class="pill placeholder" title="An updated PDF version is on its way">PDF version coming soon</span>
      )
    }
  </header>

  {
    sections.map(([title, entries]) => (
      <section>
        <h2>{title}</h2>
        {entries.map((e) => (
          <div class="entry">
            <div class="period">{e.period}</div>
            <div class="logo">{e.logo && <img src={e.logo} alt={e.org ?? ''} loading="lazy" />}</div>
            <div>
              <div class="what">
                <strong>{e.title}</strong>
                {e.org && <span>, {e.org}</span>}
                {e.place && <span class="faint"> · {e.place}</span>}
              </div>
              {e.details && (
                <ul>
                  {e.details.map((d) => <li set:html={md(d)} />)}
                </ul>
              )}
            </div>
          </div>
        ))}
      </section>
    ))
  }

  <section>
    <h2>Publications</h2>
    <ol class="pubs">
      {
        pubs.map((p) => (
          <li>
            <a href={p.href} class:list={{ ext: p.external }} target={p.external ? '_blank' : undefined} rel="noopener">{p.title}</a>
            <br />
            <span class="muted"><AuthorList authors={p.authors} linked={false} max={8} /></span>
            <br />
            <em class="muted">{venueLine(p)}</em>
          </li>
        ))
      }
    </ol>
    <p class="full-list">Full list: <a href="/publications">publications page</a></p>
  </section>

  <section>
    <h2>Skills</h2>
    <dl class="skills">
      {
        cv.skills.map((s) => (
          <>
            <dt>{s.group}</dt>
            <dd>{s.items.join(' · ')}</dd>
          </>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .cv-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  h1 { font-size: 2.1rem; margin: 0 0 0.3rem; }
  .cv-head p { margin: 0; }
  .downloads { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .placeholder { cursor: default; color: var(--text-faint); border-style: dashed; }
  .placeholder:hover { color: var(--text-faint); border-color: var(--line); }
  h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.4rem; }
  .entry { display: grid; grid-template-columns: 110px 48px 1fr; gap: 1.1rem; padding: 0.6rem 0; align-items: start; }
  .logo {
    width: 48px; height: 48px; border-radius: 10px; display: grid; place-items: center;
  }
  .logo:has(img) { background: #fff; border: 1px solid var(--line); }
  .logo img { max-width: 36px; max-height: 36px; object-fit: contain; }
  .period { color: var(--text-faint); font-size: 0.9rem; font-variant-numeric: tabular-nums; padding-top: 0.1rem; }
  .entry ul { margin: 0.25rem 0 0; padding-left: 1.1rem; color: var(--text-soft); font-size: 0.95rem; }
  .pubs { padding-left: 1.3rem; margin: 0; }
  .pubs li { margin-bottom: 1rem; font-size: 0.95rem; line-height: 1.5; }
  .pubs a { color: var(--text); font-weight: 500; }
  .pubs a:hover { color: var(--accent); }
  .full-list { font-size: 0.9rem; color: var(--text-faint); margin: 0.2rem 0 0; }
  .skills { display: grid; grid-template-columns: 170px 1fr; gap: 0.5rem 1.2rem; margin: 0; }
  .skills dt { font-weight: 600; font-size: 0.95rem; }
  .skills dd { margin: 0; color: var(--text-soft); font-size: 0.95rem; }

  @media (max-width: 620px) {
    .entry { grid-template-columns: 48px 1fr; gap: 0.2rem 0.9rem; }
    .entry .period { grid-column: 1 / -1; }
    .skills { grid-template-columns: 1fr; gap: 0.1rem; }
    .skills dd { margin-bottom: 0.6rem; }
  }
</style>
